<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.bmicalculator.controller.BMIController"
      spacing="10.0" prefWidth="420.0" prefHeight="520.0"
      style="-fx-background-color: #f7fef9;">
    <padding><Insets top="30" right="32" bottom="30" left="32"/></padding>
    <children>
        <Label text="Masukkan Data Anda"
               style="-fx-text-fill: #14532d; -fx-font-size: 22px; -fx-font-weight: bold;"/>

        <Label text="Berat Badan (kg):"
               style="-fx-text-fill: #166534; -fx-font-weight: bold;"/>
        <TextField fx:id="tfBerat" promptText="Masukkan berat dalam kg"
                   style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #bbf7d0; -fx-padding: 10 16 10 16;"/>

        <Label text="Tinggi Badan (cm):"
               style="-fx-text-fill: #166534; -fx-font-weight: bold;"/>
        <TextField fx:id="tfTinggi" promptText="Masukkan tinggi dalam cm"
                   style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #bbf7d0; -fx-padding: 10 16 10 16;"/>

        <HBox spacing="12.0">
            <padding><Insets top="6" bottom="6"/></padding>
            <children>
                <Button fx:id="btnHitung" text="Hitung BMI" onAction="#handleHitung"
                        defaultButton="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 11 16 11 16;"/>
                <Button fx:id="btnReset" text="Reset" onAction="#handleReset"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: #dcfce7; -fx-text-fill: #166534; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 11 16 11 16;"/>
            </children>
        </HBox>

        <VBox spacing="4.0"
              style="-fx-background-color: white; -fx-border-color: #bbf7d0; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 16 18 16 18;">
            <children>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Nilai BMI:" style="-fx-text-fill: #64748b;"/>
                        <Label fx:id="lblNilaiBMI" text="-"
                               style="-fx-text-fill: #15803d; -fx-font-size: 34px; -fx-font-weight: bold;"/>
                    </children>
                </HBox>
                <Label text="Kategori:" style="-fx-text-fill: #64748b;"/>
                <Label fx:id="lblKategori" text="-" wrapText="true"
                       style="-fx-text-fill: #14532d; -fx-font-size: 17px; -fx-font-weight: bold;"/>
            </children>
        </VBox>
    </children>
</VBox>
